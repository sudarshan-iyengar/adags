diff --git a/utils/cer_gate.py b/utils/cer_gate.py
new file mode 100644
index 0000000..1d1e8bd
--- /dev/null
+++ b/utils/cer_gate.py
@@ -0,0 +1,43 @@
+#
+# Complementary Episode Residuals (CER): the opacity gate applied at every foreground/background render site.
+# Spec: research-wiki/operations/cer-multi4d-spec-2026-09-30.md (ADAGS repository), section 2.1.
+#
+import re
+
+import torch
+
+ARMED = False  # set by scene/cer.py begin(); once armed, a model without CER state may not be rendered
+_PATH = re.compile(r"cam(\d\d)/images/(\d{4})\.png$")
+
+
+def parse(path):
+    """(camera, frame) from .../camNN/images/FFFF.png; raises on anything else."""
+    m = _PATH.search(path or "")
+    assert m, "CER cannot read camera and frame from %r" % (path,)
+    return int(m.group(1)), int(m.group(2))
+
+
+def frame(cam):
+    """The integer frame of a camera, parsed once and cached on the camera object."""
+    if not hasattr(cam, "cer_frame"):
+        cam.cer_frame = parse(cam.image_path)[1]
+    return cam.cer_frame
+
+
+def factor(pc, cam):
+    """[N, 1] float32 factor of one bank: memory rows (1) off and residual rows (2) on inside the gap."""
+    assert hasattr(pc, "cer_labels"), "CER is armed but this model carries no CER state"
+    n = float(pc.cer_clock[0] <= frame(cam) <= pc.cer_clock[1])
+    f = torch.ones((pc.cer_labels.shape[0], 1), device="cuda")
+    f[pc.cer_labels == 1] = 1 - pc.cer_q * n
+    f[pc.cer_labels == 2] = pc.cer_q * n
+    return f
+
+
+def apply(pc, cam, opacity):
+    """The activated opacity, multiplied by the CER factor once CER is armed."""
+    if not ARMED:
+        return opacity
+    f = factor(pc, cam)
+    assert f.shape == opacity.shape, "CER labels %s vs opacity %s" % (tuple(f.shape), tuple(opacity.shape))
+    return opacity * f
