+run_dir, tree, scene_dir = sys.argv[1], sys.argv[2], sys.argv[3]
+d, o, p, fg, bg, tr, scene = load_model(run_dir, tree)
+scene.cer_scene = scene_dir
+A, B, ids = cer.event(scene_dir)
+views = list(cer._region(scene, range(0, A, 20)))
+import gaussian_renderer.diff_gaussian_rasterization_hybrid as hybrid
+fired = "no"
+try:  # descriptive: the same mass on the training build, whose backward reads the unwritten max_contrib
