@@ -0,0 +1,536 @@
+"""Tests for Complementary Episode Residuals (CER) on Multi4D, written before the CER code.
+
+Spec: research-wiki/operations/cer-multi4d-spec-2026-09-30.md (ADAGS repository), section 7.
+Run from the root of this worktree on one GPU node:
+
+    python test_cer.py --run <wave-1 Multi4D run dir> --tree <multi4d tree> --cer_scene <canonical scene> \
+        --pinned <unmodified multi4d checkout> --out <scratch dir> --tests T0,T1,T2,T2b,T3,T4,T5,T6
+
+The model is the run's saved iteration-20000 point clouds, loaded as the ARS census loaded them (Multi4D's own load
+path, then the transient time-SH degree set to its trained maximum), as a stand-in for the model at CER start.
+Nothing is written into the run, the tree or the pinned checkout. Exits non-zero if any requested test fails.
+"""
+import hashlib
+import json
+import os
+import re
+import subprocess
+import sys
+from argparse import ArgumentParser, Namespace
+
+import torch
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+
+# Loads the model with the census loader and dumps the sha256 of every cam00 render (the final-render call).
+LOADER = r'''
+import os, random, sys
+from argparse import ArgumentParser
+import numpy as np, torch, mmcv
+from arguments import ModelParams, PipelineParams, OptimizationParams, ModelHiddenParams
+from utils.params_utils import merge_hparams
+from scene import GaussianModel, GaussianModel_dynamic, Scene2gs_mixed
+from scene.gaussian_model import GaussianModelTransient
+
+
+def load_model(run_dir, tree):
+    """Build arguments and the three banks as train.py does, and load the run's saved iteration-20000 state."""
+    parser = ArgumentParser()
+    lp, op, pp, hp = ModelParams(parser), OptimizationParams(parser), PipelineParams(parser), ModelHiddenParams(parser)
+    parser.add_argument("--expname", type=str, default="")
+    parser.add_argument("--configs", type=str, default="")
+    model_dir = os.path.join(run_dir, "model")
+    args = parser.parse_args(["-s", tree, "--model_path", model_dir, "--configs", "arguments/dynerf.py"])
+    args = merge_hparams(args, mmcv.Config.fromfile(args.configs))
+    random.seed(0); np.random.seed(0); torch.manual_seed(0)
+    torch.backends.cudnn.deterministic = True
+    d, o, p, h = lp.extract(args), op.extract(args), pp.extract(args), hp.extract(args)
+    d.sh_degree = 3
+    fg = GaussianModel_dynamic(d.sh_degree, h)
+    bg = GaussianModel(d.sh_degree)
+    tr = GaussianModelTransient(d.sh_degree, gaussian_dim=4, time_duration=list(getattr(o, "transient_time_duration", [0.0, 10.0])),
+                                rot_4d=True, sh_degree_t=2)
+    d.model_path = model_dir
+    scene = Scene2gs_mixed(d, fg, load_iteration=model_dir, gaussians_second=bg, gaussians_transient=tr)
+    assert scene.loaded_iter == 20000, scene.loaded_iter
+    tr.active_sh_degree_t = tr.max_sh_degree_t  # load_ply restores only the spatial degree
+    for m in (fg, bg, tr):
+        m.training_setup(o)
+    return d, o, p, fg, bg, tr, scene
+'''
+
+DUMP = LOADER + r'''
+import hashlib, json
+from gaussian_renderer import render_rawall3pc
+run_dir, tree, out = sys.argv[1], sys.argv[2], sys.argv[3]
+d, o, p, fg, bg, tr, scene = load_model(run_dir, tree)
+black = torch.zeros(3, device="cuda")
+digests = {}
+with torch.no_grad():
+    for cam in scene.getTestCameras():
+        img = render_rawall3pc(cam, fg, bg, tr, p, bg_color=black, stage="fine")["render"]
+        digests[int(cam.image_name)] = hashlib.sha256(img.cpu().numpy().tobytes()).hexdigest()
+json.dump(digests, open(out, "w"))
+'''
+
+exec(LOADER)  # load_model in this process (code under test = this tree)
+_load_model = load_model
+
+
+def load_model(run_dir, tree):
+    """load_model with the gate unarmed first: begin() arms the whole process, and each test loads a fresh model."""
+    from utils import cer_gate
+    cer_gate.ARMED = False
+    return _load_model(run_dir, tree)
+
+
+def dump(root, a, out):
+    """Run DUMP with `root` as the code under test; return {frame: sha256}."""
+    env = dict(os.environ, PYTHONDONTWRITEBYTECODE="1")
+    if root != HERE:  # the pinned tree builds its extension in its own directory, never the CER one
+        env["TORCH_EXTENSIONS_DIR"] = os.environ["TORCH_EXTENSIONS_DIR_PINNED"]
+    subprocess.run([sys.executable, "-c", DUMP, a.run, a.tree, out], cwd=root, env=env, check=True)
+    return {int(k): v for k, v in json.load(open(out)).items()}
+
+
+def digest(fg, bg, tr, scene, p, frames=None):
+    """sha256 of the cam00 final-call renders at `frames` (default all)."""
+    from gaussian_renderer import render_rawall3pc
+    black = torch.zeros(3, device="cuda")
+    out = {}
+    with torch.no_grad():
+        for cam in scene.getTestCameras():
+            f = int(cam.image_name)
+            if frames is None or f in frames:
+                img = render_rawall3pc(cam, fg, bg, tr, p, bg_color=black, stage="fine")["render"]
+                out[f] = hashlib.sha256(img.cpu().numpy().tobytes()).hexdigest()
+    return out
+
+
+_n = [0]
+
+
+def begun(a, q):
+    """Load the run in this process and start CER on it (reports go to a fresh scratch dir), strength q."""
+    from scene import cer
+    d, o, p, fg, bg, tr, scene = load_model(a.run, a.tree)
+    _n[0] += 1
+    scene.model_path = os.path.join(a.out, "begin_%d" % _n[0])
+    os.makedirs(scene.model_path)
+    scene.cer_scene = a.cer_scene
+    cer.begin(fg, bg, tr, scene, p, o, o.densify_until_iter)
+    for m in (fg, bg):
+        m.cer_q = q
+    return d, o, p, fg, bg, tr, scene
+
+
+def check(name, ok, detail, R):
+    """Record one criterion."""
+    R.append({"test": name, "pass": bool(ok), "detail": detail})
+    print(("PASS " if ok else "FAIL ") + name + ": " + json.dumps(detail, default=str), flush=True)
+
+
+def test_cam(scene, frame):
+    """The cam00 camera of `frame` (the test set is cam00 in frame order)."""
+    cam = scene.getTestCameras()[frame]
+    assert int(cam.image_name) == frame
+    return cam
+
+
+def t0_t1(a, R):
+    """T0: the unmodified checkout renders twice identically. T1: this tree with CER off matches it."""
+    base = dump(a.pinned, a, os.path.join(a.out, "t0_a.json"))
+    again = dump(a.pinned, a, os.path.join(a.out, "t0_b.json"))
+    check("T0 pinned render repeatable", base == again and len(base) == 300, {"frames": len(base)}, R)
+    ours = dump(HERE, a, os.path.join(a.out, "t1.json"))
+    check("T1 CER off == unmodified", ours == base, {"differing": [f for f in base if ours.get(f) != base[f]][:10]}, R)
+    return base
+
+
+def t2(a, base, R):
+    """T2: q = 0 renders equal the unmodified ones; at q = 1 a gap frame differs."""
+    d, o, p, fg, bg, tr, scene = begun(a, 0.0)
+    got = digest(fg, bg, tr, scene, p)
+    k = int((bg.cer_labels == 2).sum())
+    for m in (fg, bg):
+        m.cer_q = 1.0
+    mid = sum(bg.cer_clock) // 2
+    on = digest(fg, bg, tr, scene, p, [mid])
+    check("T2 q=0 == unmodified", got == base and k > 0 and on[mid] != base[mid],
+          {"differing": [f for f in base if got.get(f) != base[f]][:10], "residual_rows": k}, R)
+
+
+def t_birth(a, R):
+    """T2b: begin leaves existing rows' parameters, buffers and Adam moments untouched; new rows are consistent."""
+    from scene import cer
+    d, o, p, fg, bg, tr, scene = load_model(a.run, a.tree)
+    scene.model_path = os.path.join(a.out, "birth")
+    os.makedirs(scene.model_path)
+    scene.cer_scene = a.cer_scene
+    for m in (fg, bg, tr):  # one step with small gradients so every group has Adam moments to preserve
+        for gr in m.optimizer.param_groups:
+            gr["params"][0].grad = torch.full_like(gr["params"][0], 1e-6)
+        m.optimizer.step()
+        m.optimizer.zero_grad(set_to_none=True)
+    snap = {}
+    for name, m in (("fg", fg), ("bg", bg), ("tr", tr)):
+        snap[name] = ({k: v.detach().clone() for k, v in vars(m).items() if torch.is_tensor(v)},
+                      {gr["name"]: {s: t.clone() for s, t in m.optimizer.state.get(gr["params"][0], {}).items() if torch.is_tensor(t)}
+                       for gr in m.optimizer.param_groups})
+    n_bg = bg.get_xyz.shape[0]
+    cer.begin(fg, bg, tr, scene, p, o, o.densify_until_iter)
+    k = int((bg.cer_labels == 2).sum())
+    bad = []
+    for name, m in (("fg", fg), ("bg", bg), ("tr", tr)):
+        tensors, moments = snap[name]
+        for key, old in tensors.items():
+            new = getattr(m, key)
+            if name == "bg" and old.dim() > 0 and old.shape[0] == n_bg:
+                ok = new.shape[0] == n_bg + k and torch.equal(new[:n_bg], old)
+            else:
+                ok = torch.equal(new, old)
+            if not ok:
+                bad.append((name, key))
+        for gr in m.optimizer.param_groups:
+            st = m.optimizer.state.get(gr["params"][0], {})
+            if not moments[gr["name"]]:
+                bad.append((name, gr["name"], "no moments to compare"))
+            for s, old in moments[gr["name"]].items():
+                new = st.get(s)
+                if name == "bg" and old.dim() > 0 and old.shape[0] == n_bg:
+                    ok = new is not None and new.shape[0] == n_bg + k and torch.equal(new[:n_bg], old) and bool((new[n_bg:] == 0).all())
+                else:
+                    ok = new is not None and torch.equal(new, old)
+                if not ok:
+                    bad.append((name, gr["name"], s))
+            if name == "bg" and getattr(bg, "_" + {"f_dc": "features_dc", "f_rest": "features_rest"}.get(gr["name"], gr["name"])) is not gr["params"][0]:
+                bad.append(("bg attribute not the optimizer's parameter", gr["name"]))
+    check("T2b birth state", not bad and k > 0, {"residual_rows": k, "bad": bad[:10]}, R)
+
+
+def t3(a, R):
+    """T3: the four render functions gate identically (-inf logit reference, captured rasterizer inputs), gradients."""
+    import gaussian_renderer as gr_mod
+    from gaussian_renderer import render_background, render_foreground, render_mask, render_rawall3pc
+    from utils import cer_gate
+    d, o, p, fg, bg, tr, scene = begun(a, 1.0)
+    A, B = bg.cer_clock
+    black = torch.zeros(3, device="cuda")
+    if not bool((fg.cer_labels == 1).any()):  # foreground witness: the foreground rows most visible at mid-gap
+        with torch.no_grad():
+            w = render_rawall3pc(test_cam(scene, (A + B) // 2), fg, bg, tr, p, bg_color=black, stage="fine")["max_weights_fg"]
+        fg.cer_labels[torch.topk(w, min(200, int((w > 0).sum()))).indices] = 1
+        print("T3: labelled %d visible foreground rows memory as a witness" % int((fg.cer_labels == 1).sum()))
+    captured = []
+    originals = (gr_mod.GaussianRasterizer.forward, gr_mod.GaussianRasterizer_hybrid.forward)
+
+    def cap_plain(self, *args, **kw):
+        captured.append(("plain", kw["opacities"].detach().clone()))
+        return originals[0](self, *args, **kw)
+
+    def cap_hybrid(self, *args, **kw):
+        captured.append(("hybrid", kw["opacities_static"].detach().clone(), kw["opacities"].detach().clone()))
+        return originals[1](self, *args, **kw)
+
+    def calls(cam):
+        """The four render functions, as the training/evaluation code calls them (dropout off)."""
+        ones = torch.ones((int(cam.image_height), int(cam.image_width)), device="cuda")
+        return {"background": lambda: render_background(cam, bg, p, black, stage="coarse", prob_mask=ones)["render"],
+                "foreground": lambda: render_foreground(cam, fg, p, black, stage="fine", prob_mask=ones)["render"],
+                "mask": lambda: render_mask(cam, fg, p, black, stage="fine")["render"],
+                "hybrid": lambda: render_rawall3pc(cam, fg, bg, tr, p, bg_color=black, stage="fine")["render"]}
+
+    def reference(cam, off_fg, off_bg, fn):
+        """The same call with CER off after setting the switched-off rows' logits to -inf."""
+        saved = (fg._opacity.data.clone(), bg._opacity.data.clone())
+        fg._opacity.data[off_fg] = -float("inf")
+        bg._opacity.data[off_bg] = -float("inf")
+        cer_gate.ARMED = False
+        try:
+            return fn()
+        finally:
+            cer_gate.ARMED = True
+            fg._opacity.data.copy_(saved[0])
+            bg._opacity.data.copy_(saved[1])
+
+    bad = []
+    for frame in [(A + B) // 2, A - 1]:
+        cam = test_cam(scene, frame)
+        inside = A <= frame <= B
+        off_fg = (fg.cer_labels == 1) if inside else (fg.cer_labels == 2)
+        off_bg = (bg.cer_labels == 1) if inside else (bg.cer_labels == 2)
+        for name, fn in calls(cam).items():
+            with torch.no_grad():
+                on = fn()
+                ref = reference(cam, off_fg, off_bg, fn)
+                cer_gate.ARMED = False
+                plain = fn()
+                cer_gate.ARMED = True
+            if not torch.equal(on, ref):
+                bad.append((frame, name, "differs from the -inf reference"))
+            if inside and torch.equal(ref, plain):
+                bad.append((frame, name, "reference equals the ungated render (vacuous)"))
+    check("T3 four render functions gate identically", not bad, {"bad": bad}, R)
+
+    gr_mod.GaussianRasterizer.forward, gr_mod.GaussianRasterizer_hybrid.forward = cap_plain, cap_hybrid
+    try:
+        cam = test_cam(scene, (A + B) // 2)
+        with torch.no_grad():
+            for name, fn in calls(cam).items():
+                fn()
+            cer_gate.ARMED = False
+            for name, fn in calls(cam).items():
+                fn()
+            cer_gate.ARMED = True
+    finally:
+        gr_mod.GaussianRasterizer.forward, gr_mod.GaussianRasterizer_hybrid.forward = originals
+    on, off = captured[:4], captured[4:]
+    f_fg = cer_gate.factor(fg, cam)
+    f_bg = cer_gate.factor(bg, cam)
+    want = [off[0][1] * f_bg, off[1][1] * f_fg, off[2][1] * f_fg, torch.cat([off[3][1][:f_fg.shape[0]] * f_fg, off[3][1][f_fg.shape[0]:] * f_bg])]
+    ok = [torch.equal(on[i][1], want[i]) for i in range(4)] + [torch.equal(on[3][2], off[3][2])]
+    check("T3 rasterizer inputs are factor x ungated (transient untouched)", all(ok), {"per_call": ok}, R)
+
+    # gradients on the instrument build: the training build's backward skips tiles on uninitialised max_contrib
+    from scene import cer
+    leaks, control = {}, None
+    with cer.instrument_kernel():
+        for frame, cohort in [((A + B) // 2, 1), (A - 1, 2)]:
+            cam = test_cam(scene, frame)
+            for m in (fg, bg, tr):
+                m.optimizer.zero_grad(set_to_none=True)
+            render_rawall3pc(cam, fg, bg, tr, p, bg_color=black, stage="fine")["render"].sum().backward()
+            for name, m in (("fg", fg), ("bg", bg)):
+                for pname in ("_xyz", "_features_dc", "_features_rest", "_opacity", "_scaling", "_rotation"):
+                    g = getattr(m, pname).grad
+                    if g is None or bool((g[m.cer_labels == cohort] != 0).any()):
+                        leaks.setdefault(frame, []).append((name, pname, None if g is None else "nonzero"))
+        for m in (fg, bg):
+            m.cer_q = 0.0
+        cam = test_cam(scene, (A + B) // 2)
+        for m in (fg, bg, tr):
+            m.optimizer.zero_grad(set_to_none=True)
+        render_rawall3pc(cam, fg, bg, tr, p, bg_color=black, stage="fine")["render"].sum().backward()
+        control = bool((bg._opacity.grad[bg.cer_labels == 1] != 0).any())
+    check("T3 zero rendering gradient to the switched-off cohort", not leaks and control,
+          {"leaks": leaks, "control_q0_memory_gets_gradient": control}, R)
+
+    bad = []
+    for ds in (scene.getTrainCameras().dataset, scene.getTestCameras().dataset):  # every camera, from its path and time
+        for path, t in zip(ds.image_paths, ds.image_times):
+            if cer_gate.parse(path)[1] != round(t * 300):
+                bad.append(path)
+    malformed = Namespace(image_path="/x/cam01/images/60.png")
+    try:
+        cer_gate.frame(malformed)
+        raised = False
+    except AssertionError:
+        raised = True
+    check("T3 frame parse", not bad and raised, {"mismatch": bad[:5], "malformed_raises": raised}, R)
+
