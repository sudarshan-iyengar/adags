+def t4(a, R):
+    """T4: split identity, memory share, exact zeros (per-render conservation is asserted inside mass)."""
+    from scene import cer
+    d, o, p, fg, bg, tr, scene = begun(a, 1.0)
+    A, B, ids = cer.event(a.cer_scene)
+    views = list(cer.train_views(scene, range(0, A, 7)))
+    worst = 0.0
+    for cam in views:
+        m = cer.target_mask(a.cer_scene, ids, cer.cam_number(cam), cer_frame(cam))
+        (i_fg, i_bg, i_tr), (t_fg, t_bg, t_tr) = cer.mass(fg, bg, tr, p, [(cam, m)])
+        (c_fg, c_bg, c_tr), _ = cer.mass(fg, bg, tr, p, [(cam, 1 - m)])
+        tot = t_fg.sum() + t_bg.sum() + t_tr.sum()
+        err = (i_fg + c_fg - t_fg).abs().sum() + (i_bg + c_bg - t_bg).abs().sum() + (i_tr + c_tr - t_tr).abs().sum()
+        worst = max(worst, (err / tot).item())
+    check("T4 mask split", worst < 1e-5, {"max_rel": worst, "views": len(views)}, R)
+    rep = json.load(open(os.path.join(scene.model_path, "cer_begin.json")))
+    check("T4 memory share pre-gap (ungated) >= 0.5", rep["memory_share_pregap"] >= 0.5, rep, R)
+    tot = {}
+    for w, frames in {"pre": range(0, A), "gap": range(A, B + 1), "ret": range(B + 1, B + 31)}.items():
+        vm = [(cam, torch.ones((int(cam.image_height), int(cam.image_width)), device="cuda")) for cam in cer.train_views(scene, frames)]
+        _, (t_fg, t_bg, t_tr) = cer.mass(fg, bg, tr, p, vm)
+        tot[w] = {c: (t_fg[fg.cer_labels == c].sum() + t_bg[bg.cer_labels == c].sum()).item() for c in (0, 1, 2)}
+    check("T4 exact zeros at q=1", tot["gap"][1] == 0.0 and tot["pre"][2] == 0.0 and tot["ret"][2] == 0.0
+          and tot["gap"][2] > 0.0 and tot["pre"][1] > 0.0, tot, R)
+
