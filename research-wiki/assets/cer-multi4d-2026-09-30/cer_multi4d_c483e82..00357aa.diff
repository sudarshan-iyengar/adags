+def t6(a, R):
+    """T6: every row-changing call in train.py sits inside maintain_* (or begin); the sentinels raise after begin."""
+    src = open(os.path.join(HERE, "train.py")).read().splitlines()
+    from scene import cer
+    pat = re.compile(r"\.(%s)\(" % "|".join(sorted(cer.LIFECYCLE, key=len, reverse=True)))
+    owner, stray = None, []
+    for i, line in enumerate(src, 1):
+        m = re.match(r"def (\w+)\(", line)
+        if m:
