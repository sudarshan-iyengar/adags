+++ b/scene/cer.py
@@ -0,0 +1,219 @@
+#
+# Complementary Episode Residuals (CER) for Multi4D.
+# Spec: research-wiki/operations/cer-multi4d-spec-2026-09-30.md (ADAGS repository).
+#
+# A memory cohort (foreground/background rows that paint the target before it leaves) is switched off inside the
+# gap [A, B]; a residual cohort (copies of the background rows that paint the gap region once the memory rows are
+# off) exists only inside it. Both are set once, at the end of fine iteration densify_until_iter, after which no
+# bank changes its rows (sentinels enforce it).
+#
+import contextlib
+import json
+import os
+
+import numpy as np
+import torch
+from torch.utils.cpp_extension import load
+
+import gaussian_renderer.diff_gaussian_rasterization_hybrid as hybrid
+from gaussian_renderer import render_rawall3pc
+from utils import cer_gate
+from utils.sh_utils import C0
+
+LIFECYCLE = ("prune_points", "_prune_optimizer", "densify_and_clone", "densify_and_split", "densify_and_prune",
+             "densify", "densification_postfix", "densification_postfix_nodenom", "add_points", "add_points_from_dict",
+             "weight_prune", "prune", "reset_opacity", "reset_opacity_partially", "reset_opacity_partially_small",
+             "cat_tensors_to_optimizer", "replace_tensor_to_optimizer")
+
+
+def event(scene_dir):
+    """Clock (A, B) and target part ids from the canonical scene's event_spec.json."""
+    spec = json.load(open(os.path.join(scene_dir, "event_spec.json")))
+    ids = [p["id"] for o in spec["objects"] if o.get("role") == "target" for p in o["parts"]]
+    return spec["clock"]["A"], spec["clock"]["B"], sorted(set(ids))
+
+
+def cam_number(cam):
+    """Camera number parsed from the camera's image path."""
+    return cer_gate.parse(cam.image_path)[0]
+
+
+def train_views(scene, frames):
+    """Training cameras (never cam00) whose frame is in `frames`, built only for the frames asked for."""
+    frames, ds = set(frames), scene.getTrainCameras()
+    for i, path in enumerate(ds.dataset.image_paths):
+        c, f = cer_gate.parse(path)
+        if f in frames:
+            assert c != 0
+            yield ds[i]
+
+
+def target_mask(scene_dir, ids, cam_no, frame):
+    """[H, W] float mask of the target's front-most pixels in camera cam_no at frame."""
+    ident = np.load(os.path.join(scene_dir, "gt", "identity", "cam%02d.npz" % cam_no))["f%04d" % frame]
+    return torch.from_numpy(np.isin(ident, ids)).float().cuda()
+
+
+def _region(scene, frames, mask_frame=None):
+    """(camera, target mask) for training views at `frames`; mask taken at mask_frame if given."""
+    A, B, ids = event(scene.cer_scene)
+    for cam in train_views(scene, frames):
+        t = cer_gate.frame(cam) if mask_frame is None else mask_frame
+        yield cam, target_mask(scene.cer_scene, ids, cam_number(cam), t)
+
+
+_INSTRUMENT = []
+
+
+@contextlib.contextmanager
+def instrument_kernel():
+    """Swap in the hybrid rasterizer built with -DCER_WRITE_MAX_CONTRIB (it writes max_contrib, which the upstream
+    backward's early exit reads); the training build is restored on exit. Built once, lazily, under its own name."""
+    if not _INSTRUMENT:
+        d = hybrid.parent_dir
+        _INSTRUMENT.append(load(
+            name="diff_gaussian_rasterization_hybrid_cer",
+            extra_cuda_cflags=["-I " + os.path.join(d, "third_party/glm/"), "-g", "-DCER_WRITE_MAX_CONTRIB"],
+            sources=[os.path.join(d, "cuda_rasterizer/rasterizer_impl.cu"), os.path.join(d, "cuda_rasterizer/forward.cu"),
+                     os.path.join(d, "cuda_rasterizer/backward.cu"), os.path.join(d, "rasterize_points.cu"),
+                     os.path.join(d, "ext.cpp")],
+            verbose=True))
+    training = hybrid._C
+    hybrid._C = _INSTRUMENT[0]
+    try:
+        yield
+    finally:
+        hybrid._C = training
+
+
+def _mass(fg, bg, tr, pipe, views):
+    """Per-row contribution mass sum(alpha*T) inside each view's mask and over all pixels, per bank.
+
+    Every bank's SH is swapped for a DC-only colour of 1.0 for the duration; the gradient of the final hybrid render
+    with respect to the DC leaves, divided by SH_C0, is alpha*T. Runs on the instrument kernel (the upstream backward
+    reads an uninitialised max_contrib) and asserts conservation on every render.
+    Returns ([fg, bg, tr] inside, [fg, bg, tr] total), float64.
+    """
+    banks = (fg, bg, tr)
+    saved = [(m._features_dc, m._features_rest) for m in banks]
+    inside, total = [0, 0, 0], [0, 0, 0]
+    black = torch.zeros(3, device="cuda")
+    try:
+        with torch.enable_grad():
+            leaves = []
+            for m in banks:
+                leaves.append(torch.full_like(m._features_dc, 0.5 / C0).requires_grad_(True))
+                m._features_dc, m._features_rest = leaves[-1], torch.zeros_like(m._features_rest)
+            for cam, mask in views:
+                img = render_rawall3pc(cam, fg, bg, tr, pipe, bg_color=black, stage="fine")["render"]
+                assert img.shape[1:] == mask.shape
+                grads = torch.autograd.grad((img[0] * mask).sum() + img[1].sum(), leaves)
+                per = [g[:, 0].double() / C0 for g in grads]
+                got, ref = sum(p[:, 1].sum() for p in per).item(), img[1].double().sum().item()
+                assert abs(got - ref) <= 1e-4 * ref, "CER mass not conserved on %s (%g vs %g)" % (cam.image_path, got, ref)
+                inside = [x + p[:, 0] for x, p in zip(inside, per)]
+                total = [x + p[:, 1] for x, p in zip(total, per)]
+    finally:
+        for m, (dc, rest) in zip(banks, saved):
+            m._features_dc, m._features_rest = dc, rest
+    return inside, total
+
+
+def mass(fg, bg, tr, pipe, views):
+    """_mass on the instrument kernel (the upstream backward reads an uninitialised max_contrib)."""
+    with instrument_kernel():
+        return _mass(fg, bg, tr, pipe, views)
+
+
+mass.__wrapped__ = _mass  # the same computation on the training build (T4b's descriptive comparison)
+
+
+def check_finite(fg, bg):
+    """A NaN opacity times a 0 factor renders at alpha 0.99; Multi4D has no NaN prune."""
+    for m in (fg, bg):
+        assert torch.isfinite(torch.sigmoid(m._opacity)).all(), "non-finite opacity"
+
+
+def _refuse(name):
+    """A lifecycle method that may not run after CER has begun."""
+    def refuse(*args, **kwargs):
+        raise AssertionError("CER sentinel: %s called after begin" % name)
+    return refuse
+
+
+def begin(fg, bg, tr, scene, pipe, opt, iteration):
+    """Label the memory cohort, append the residual cohort to the background, arm the gate; writes cer_begin.json."""
+    A, B, ids = event(scene.cer_scene)
+    assert iteration == opt.densify_until_iter and iteration >= getattr(opt, "phase3_start_iter", 10000)
+    check_finite(fg, bg)
+    report = open(os.path.join(scene.model_path, "cer_begin.json"), "x")  # a NaN restart must not begin twice
+    inside, total = mass(fg, bg, tr, pipe, _region(scene, range(0, A)))
+    memory = [(t > 0) & (i >= 0.5 * t) for i, t in zip(inside[:2], total[:2])]
+    for m, mem in zip((fg, bg), memory):
+        m.cer_labels, m.cer_clock, m.cer_q = mem.to(torch.uint8), (A, B), 1.0
+    cer_gate.ARMED = True
+    # donors: background rows that paint the gap region during the gap once the memory cohort is off
+    g_in, g_tot = mass(fg, bg, tr, pipe, _region(scene, range(A, B + 1), mask_frame=A - 1))
+    majority = [(t > 0) & (i >= 0.5 * t) for i, t in zip(g_in, g_tot)]
+    donors = majority[1].nonzero().squeeze(1)
+
+    with torch.no_grad():
+        new = {"xyz": bg._xyz[donors], "f_dc": bg._features_dc[donors], "f_rest": bg._features_rest[donors],
+               "opacity": bg._opacity[donors], "scaling": bg._scaling[donors], "rotation": bg._rotation[donors]}
+    t = bg.cat_tensors_to_optimizer(new)
+    bg._xyz, bg._features_dc, bg._features_rest = t["xyz"], t["f_dc"], t["f_rest"]
+    bg._opacity, bg._scaling, bg._rotation = t["opacity"], t["scaling"], t["rotation"]
+    k = donors.shape[0]
+    bg.max_radii2D = torch.cat([bg.max_radii2D, torch.zeros(k, device="cuda")])
+    bg.xyz_gradient_accum = torch.cat([bg.xyz_gradient_accum, torch.zeros((k, 1), device="cuda")])
+    bg.denom = torch.cat([bg.denom, torch.zeros((k, 1), device="cuda")])
+    bg.cer_labels = torch.cat([bg.cer_labels, torch.full((k,), 2, dtype=torch.uint8, device="cuda")])
+    for m in (fg, bg, tr):
+        for name in LIFECYCLE:
+            if hasattr(m, name):
+                setattr(m, name, _refuse(name))
+
+    gap = sum(x.sum() for x in g_in).item()
+    share = lambda x: x / gap if gap > 0 else None  # a gap region with no mass is reported, not divided by
+    json.dump({"A": A, "B": B, "target_ids": ids, "iteration": iteration,
+               "memory_rows": {"fg": int(memory[0].sum()), "bg": int(memory[1].sum())},
+               "memory_share_pregap": ((inside[0][memory[0]].sum() + inside[1][memory[1]].sum())
+                                       / sum(x.sum() for x in inside)).item(),
+               "residual_rows": k,
+               "gap_region_share_by_bank": {b: share(g_in[i].sum().item()) for i, b in enumerate(("fg", "bg", "tr"))},
+               "majority_donor_share_by_bank": {b: share(g_in[i][majority[i]].sum().item())
+                                                for i, b in enumerate(("fg", "bg", "tr"))},
+               "rows_after_birth": {"fg": fg.get_xyz.shape[0], "bg": bg.get_xyz.shape[0], "tr": tr.get_xyz.shape[0]}},
+              report, indent=1)
+    report.close()
+
+
+def gates(fg, bg, tr, scene, pipe):
+    """Contribution gates of spec section 6 on the final in-memory model; writes cer_gates.json."""
+    assert cer_gate.ARMED, "CER never began"
+    A, B = bg.cer_clock
+    check_finite(fg, bg)
+    pre_in, pre_tot = mass(fg, bg, tr, pipe, _region(scene, range(0, A)))
+    gap_in, gap_tot = mass(fg, bg, tr, pipe, _region(scene, range(A, B + 1), mask_frame=A - 1))
+    ret_in, ret_tot = mass(fg, bg, tr, pipe, _region(scene, range(B + 1, B + 31)))
+
+    def cohort(x, c):
+        """Mass of cohort c over the foreground and background banks."""
+        return (x[0][fg.cer_labels == c].sum() + x[1][bg.cer_labels == c].sum()).item()
+
+    def whole(x):
+        """Mass of every row of every bank."""
+        return sum(v.sum() for v in x).item()
+
+    out = {"memory_share_pregap": cohort(pre_in, 1) / whole(pre_in),
+           "memory_share_return": cohort(ret_in, 1) / whole(ret_in),
+           "memory_mass_gap": cohort(gap_tot, 1),
+           "residual_share_gap": cohort(gap_in, 2) / whole(gap_in),
+           "residual_mass_outside_gap": cohort(pre_tot, 2) + cohort(ret_tot, 2),
+           "transient_share_gap_region": gap_in[2].sum().item() / whole(gap_in),
+           "memory_rows": {"fg": int((fg.cer_labels == 1).sum()), "bg": int((bg.cer_labels == 1).sum())},
+           "rows_at_end": {"fg": fg.get_xyz.shape[0], "bg": bg.get_xyz.shape[0], "tr": tr.get_xyz.shape[0]}}
+    out["pass"] = (out["memory_share_pregap"] >= 0.5 and out["memory_share_return"] >= 0.5
+                   and out["memory_mass_gap"] == 0.0 and out["residual_share_gap"] >= 0.2
+                   and out["residual_mass_outside_gap"] == 0.0)
+    json.dump(out, open(os.path.join(scene.model_path, "cer_gates.json"), "w"), indent=1)
