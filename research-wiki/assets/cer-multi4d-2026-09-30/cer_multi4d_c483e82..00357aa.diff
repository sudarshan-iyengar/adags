+def main():
+    """Parse arguments, run the requested tests, write results.json, exit non-zero on failure."""
+    ap = ArgumentParser()
+    ap.add_argument("--run", required=True)
+    ap.add_argument("--tree", required=True)
+    ap.add_argument("--cer_scene", required=True)
+    ap.add_argument("--pinned", default="")
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--tests", default="T0,T1,T2,T2b,T3,T4,T4b,T5,T6")
+    ap.add_argument("--t7_iter", type=int, default=0)
+    ap.add_argument("--t7_metrics", default="")
+    a = ap.parse_args()
+    os.makedirs(a.out, exist_ok=True)
+    tests = a.tests.split(",")
+    unknown = set(tests) - {"T0", "T1", "T2", "T2b", "T3", "T4", "T4b", "FORECAST", "T5", "T6", "T7"}
+    if unknown:
+        ap.error("unknown tests: %s" % sorted(unknown))
+    R = []
+    try:
+        base = t0_t1(a, R) if {"T0", "T1", "T2"} & set(tests) else None
+        if "T2" in tests:
+            t2(a, base, R)
+        for name, fn in [("T2b", t_birth), ("T3", t3), ("T4", t4), ("T4b", t4b), ("FORECAST", forecast), ("T5", t5), ("T6", t6),
+                         ("T7", t7)]:
+            if name in tests:
+                fn(a, R)
+    except Exception as e:  # a crash is a failure of the test that was running
+        import traceback
+        traceback.print_exc()
+        R.append({"test": "crash", "pass": False, "detail": repr(e)})
+    json.dump(R, open(os.path.join(a.out, "results.json"), "w"), indent=1)
+    sys.exit(0 if R and all(r["pass"] for r in R) else 1)
+
+
+if __name__ == "__main__":
+    main()
