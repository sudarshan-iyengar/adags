+++ b/scene/cer.py
@@ -0,0 +1,171 @@
+#
+# Complementary Episode Residuals (CER) for Ex4DGS.
+# Spec: research-wiki/operations/cer-ex4dgs-spec-2026-09-30.md (ADAGS repository).
+#
+# A memory cohort (rows that paint the target before it leaves) is switched off inside the
+# gap [A, B]; a residual cohort (verbatim copies, in their own bank, of the rows that paint the gap
+# region) exists only inside it. Both are set once, at the end of iteration densify_until_iter.
+#
+import json
+import os
+
+import numpy as np
+import torch
+
+from gaussian_renderer import render
+
+
+def event(scene_dir):
+    """Clock (A, B) and target part ids from the canonical scene's event_spec.json."""
+    spec = json.load(open(os.path.join(scene_dir, "event_spec.json")))
+    ids = [p["id"] for o in spec["objects"] if o.get("role") == "target" for p in o["parts"]]
+    return spec["clock"]["A"], spec["clock"]["B"], sorted(set(ids))
+
+
+def cam_number(cam):
+    """Camera number from the camNN directory of the camera's image path."""
+    return int(os.path.basename(os.path.dirname(cam.image_path))[3:])
+
+
+def train_views(scene, frames):
+    """Training cameras (never cam00) whose timestamp is in `frames`."""
+    frames = set(frames)
+    views = [c for c in scene.train_cameras[1.0] if int(c.timestamp) in frames]
+    assert all(cam_number(c) != 0 for c in views)
+    return views
+
+
+def target_mask(scene_dir, ids, cam_no, frame):
+    """[H, W] float mask of the target's front-most pixels in camera cam_no at frame."""
+    ident = np.load(os.path.join(scene_dir, "gt", "identity", "cam%02d.npz" % cam_no))["f%04d" % frame]
+    return torch.from_numpy(np.isin(ident, ids)).float().cuda()
+
+
+def mass(pc, pipe, dataset, views):
+    """Per-row contribution mass sum(alpha*T) inside each view's mask and over all pixels.
+
+    `views` yields (camera, [H, W] mask). Uses the colour gradient of a ones-colour render,
+    via autograd.grad, so no parameter .grad is touched. Returns float64 [N], [N].
+    """
+    inside = total = 0
+    bg = torch.zeros(3, device="cuda")
+    for cam, m in views:
+        colours = torch.ones((pc._xyz.shape[0] + pc._xyz_motion.shape[0], 3), device="cuda", requires_grad=True)
+        img = render(cam, pc, pipe, bg, override_color=colours, near=dataset.near, far=dataset.far)["render"]
+        assert img.shape[1:] == m.shape
+        g = torch.autograd.grad((img[0] * m).sum() + img[1].sum(), colours)[0].double()
+        inside, total = inside + g[:, 0], total + g[:, 1]
+    return inside, total
+
+
+def _region(scene, dataset, frames, mask_frame=None):
+    """(camera, target mask) for training views at `frames`; mask taken at mask_frame if given."""
+    A, B, ids = event(dataset.cer_scene)
+    for cam in train_views(scene, frames):
+        t = int(cam.timestamp) if mask_frame is None else mask_frame
+        yield cam, target_mask(dataset.cer_scene, ids, cam_number(cam), t)
+
+
+def begin(gaussians, scene, pipe, dataset):
+    """Label the memory cohort and append the residual cohort; writes cer_begin.json."""
+    g = gaussians
+    A, B, ids = event(dataset.cer_scene)
+    cams = scene.train_cameras[1.0]
+    check_finite(g, range(dataset.duration))  # verbatim copies inherit their donors' opacity
+    assert g.duration == dataset.duration + g.time_shift + 1  # expand_duration is a no-op: K cannot change
+    assert dataset.time_pad_type == 0  # integer frame timestamps, no mirrored cameras
+    assert all(os.path.realpath(c.image_path) == os.path.realpath(os.path.join(
+        dataset.cer_scene, "frames", "cam%02d" % cam_number(c), "%04d.png" % c.timestamp)) for c in cams)  # masks match images
+    assert all(scene.samplelist[i] for i, c in enumerate(cams) if 0 <= c.timestamp < dataset.duration)  # gap frames are trained
+    assert max(c.timestamp for c in cams) < scene.sample_len - g.interval  # window-end promotion can no longer fire
+    n_s = g._xyz.shape[0]
+    inside, total = mass(g, pipe, dataset, _region(scene, dataset, range(0, A)))
+    memory = (total > 0) & (inside >= 0.5 * total)
+    labels = memory.to(torch.uint8)
+    g._cer_static, g._cer_dynamic = labels[:n_s], labels[n_s:]
+    g.cer_clock, g.cer_q = (A, B), 1.0
+    # donors: rows that paint the gap region during the gap once the memory cohort is off
+    g_in, g_tot = mass(g, pipe, dataset, _region(scene, dataset, range(A, B + 1), mask_frame=A - 1))
+    donors = ((g_tot > 0) & (g_in >= 0.5 * g_tot)).nonzero().squeeze(1)
+    ds, dd = donors[donors < n_s], donors[donors >= n_s] - n_s  # bank split with the pre-birth static count
+    birth(g, ds, dd, A)
+
+    report = {"A": A, "B": B, "target_ids": ids,
+              "memory_rows_static": int(memory[:n_s].sum()), "memory_rows_dynamic": int(memory[n_s:].sum()),
+              "memory_share_pregap": (inside[memory].sum() / inside.sum()).item(),
+              "residual_rows": ds.shape[0] + dd.shape[0],
+              "residual_rows_static": ds.shape[0], "residual_rows_dynamic": dd.shape[0],
+              "donor_share_gap_region": (g_in[donors].sum() / g_in.sum()).item(),
+              "donor_share_gap_region_static": (g_in[:n_s][ds].sum() / g_in.sum()).item(),
+              "donor_share_gap_region_dynamic": (g_in[n_s:][dd].sum() / g_in.sum()).item(),
+              "donors_static": ds.tolist(), "donors_dynamic": dd.tolist()}
+    json.dump(report, open(os.path.join(dataset.model_path, "cer_begin.json"), "w"), indent=1)
+
+
+STATIC = [("xyz", "_xyz"), ("f_dc", "_features_dc"), ("f_rest", "_features_rest"), ("opacity", "_opacity"),
+          ("scaling", "_scaling"), ("rotation", "_rotation"), ("xyz_disp", "_xyz_disp")]
+DYNAMIC = [("motion_xyz", "_xyz_motion"), ("motion_f_dc", "_features_dc_motion"), ("motion_f_rest", "_features_rest_motion"),
+           ("motion_scaling", "_scaling_motion"), ("motion_opacity", "_opacity_motion"),
+           ("motion_opacity_center", "_opacity_duration_center"), ("motion_opacity_var", "_opacity_duration_var"),
+           ("motion_rotation", "_rotation_motion")]
+BUFFERS = [("xyz_gradient_accum", 0), ("denom", 0), ("xyz_error_accum", 0), ("xyz_ssim_error_accum", 0), ("error_denom", 0),
+           ("xyz_error_min", 1000), ("xyz_error_min_timestamp", None), ("max_radii2D", 0), ("min_radii2D", 1000),
+           ("motion_xyz_gradient_accum", 0), ("motion_denom", 0), ("motion_xyz_error_mean", 0),
+           ("motion_xyz_ssim_error_accum", 0), ("motion_error_denom", 0), ("motion_xyz_error_min", 1000),
+           ("motion_xyz_error_min_timestamp", None), ("motion_max_radii2D", 0), ("motion_min_radii2D", 1000)]
+
+
+def birth(g, ds, dd, A):
+    """Append residual rows: verbatim copies of static donors ds into the static bank and of dynamic donors dd
+    (bank-local indices) into the dynamic bank, labelled 2; new buffers zero, error-min 1000, timestamps A."""
+    with torch.no_grad():
+        new = {grp: getattr(g, attr)[ds] for grp, attr in STATIC}
+        new.update({grp: getattr(g, attr)[dd] for grp, attr in DYNAMIC})
+    opt = g.cat_tensors_to_optimizer(new)
+    for grp, attr in STATIC + DYNAMIC:
+        setattr(g, attr, opt[grp])
+    for name, fill in BUFFERS:
+        old = getattr(g, name)
+        k = ds.shape[0] if not name.startswith("motion_") else dd.shape[0]
+        setattr(g, name, torch.cat([old, old.new_full((k,) + old.shape[1:], A if fill is None else fill)]))
+    g._cer_static = torch.cat([g._cer_static, torch.full((ds.shape[0],), 2, dtype=torch.uint8, device="cuda")])
+    g._cer_dynamic = torch.cat([g._cer_dynamic, torch.full((dd.shape[0],), 2, dtype=torch.uint8, device="cuda")])
+
+
+def check_finite(g, frames):
+    """Assert every evaluated opacity is finite on `frames`: a NaN times a 0 factor renders at alpha 0.99."""
+    for t in frames:
+        assert torch.isfinite(g.get_opacity_at_t(t)).all(), "non-finite opacity at frame %d" % t
+
+
+def gates(gaussians, scene, pipe, dataset):
+    """Contribution gates of spec section 6 on the final model; writes cer_gates.json."""
+    g = gaussians
+    A, B = g.cer_clock
+    check_finite(g, range(dataset.duration))
+    lab = torch.cat([g._cer_static, g._cer_dynamic]).long()
+    n_s = g._cer_static.shape[0]
+
+    def share(frames, mask_frame=None):
+        """Per-cohort mass inside the target/gap region over `frames`, and per-cohort total mass."""
+        inside, total = mass(g, pipe, dataset, _region(scene, dataset, frames, mask_frame))
+        return ({c: inside[lab == c].sum().item() for c in (0, 1, 2)},
+                {c: total[lab == c].sum().item() for c in (0, 1, 2)}, inside)
+
+    pre_in, pre_tot, pre_rows = share(range(0, A))
+    gap_in, gap_tot, gap_rows = share(range(A, B + 1), mask_frame=A - 1)
+    ret_in, ret_tot, _ = share(range(B + 1, B + 31))
+    frac = lambda d, c: d[c] / max(sum(d.values()), 1e-30)
+    out = {"memory_share_pregap": frac(pre_in, 1), "memory_share_return": frac(ret_in, 1),
+           "memory_mass_gap": gap_tot[1], "residual_share_gap": frac(gap_in, 2),
+           "residual_mass_outside_gap": pre_tot[2] + ret_tot[2],
+           "memory_rows_static": int((g._cer_static == 1).sum()), "memory_rows_dynamic": int((g._cer_dynamic == 1).sum()),
+           "memory_mass_pregap_static": pre_rows[:n_s][lab[:n_s] == 1].sum().item(),
+           "memory_mass_pregap_dynamic": pre_rows[n_s:][lab[n_s:] == 1].sum().item(),
+           "residual_rows_static": int((g._cer_static == 2).sum()), "residual_rows_dynamic": int((g._cer_dynamic == 2).sum()),
+           "residual_mass_gap_region_static": gap_rows[:n_s][lab[:n_s] == 2].sum().item(),
+           "residual_mass_gap_region_dynamic": gap_rows[n_s:][lab[n_s:] == 2].sum().item()}
+    out["pass"] = (out["memory_share_pregap"] >= 0.5 and out["memory_share_return"] >= 0.5
+                   and out["memory_mass_gap"] == 0.0 and out["residual_share_gap"] >= 0.2
+                   and out["residual_mass_outside_gap"] == 0.0)
+    json.dump(out, open(os.path.join(dataset.model_path, "cer_gates.json"), "w"), indent=1)
