# Editors and operating-system metadata
/.idea/
/.vscode/
/.codex/
/.obsidian/
.DS_Store
Thumbs.db
desktop.ini

# Local datasets, run outputs, and generated analysis
/data/
/output/
/runs/
/analysis/
/refine-logs/

# Scheduler logs stay local; the policy file remains tracked.
/logs/*
!/logs/README.md
*.out
*.err
*.log

# Checkpoints, tensors, binary arrays, and serialized runtime state
*.pt
*.pth
*.ckpt
*.npy
*.npz
*.pkl
*.pickle
*.dump
snapshot_*

# Python caches and environments
__pycache__/
*.pyc
*.pyo
*.pyd
.env
*.env
venv/
env/

# Build and compiled products
build/
dist/
*.egg-info/
*.so
*.dylib
*.dll
*.a
*.o
*.obj

# Experiment service payloads
wandb/
**/wandb/
*.run

# Agent-local installations and state
/.agents/
/skills-lock.json
/.claude/
/.aris/
# Durable research-wiki pages and referenced figures are tracked normally.
# Unmanaged Obsidian attachments stay ignored; intentionally place durable
# referenced figures under research-wiki/assets/ or another tracked path.
/research-wiki/.obsidian/
/research-wiki/.trash/
/research-wiki/attachments/

# Temporary root-level verification images
/verify_*.jpg
/verify_*.png
/*_verify.png
